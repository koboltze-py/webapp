# Secrets (automatisch erzeugt, siehe backend/app/config.py)
backend/.env

# Gesundheitsdaten / lokale Datenbank
backend/data/*.db
backend/data/*.sqlite
backend/data/*.sqlite3

# Sicherungen (enthalten Gesundheitsdaten, siehe Backups/Supabase/LIESMICH.txt)
Backups/Supabase/*/
!Backups/Supabase/LIESMICH.txt

# Vollständige Software-Backups (enthalten backend/.env + lokale Datenbank
# mit Gesundheitsdaten, siehe Backups/App/LIESMICH.txt)
Backups/App/*/
!Backups/App/LIESMICH.txt

# Automatische Dienstplan-Schnappschüsse bei jedem Import/jeder Änderung
# (enthalten Mitarbeiternamen/Dienstzeiten, siehe Backups/Tagesdienstpläne/LIESMICH.txt)
Backups/Tagesdienstpläne/*/
!Backups/Tagesdienstpläne/LIESMICH.txt

# Technische Dokumentation als Backup-Snapshot (lokales Nachschlagewerk,
# nicht Teil des Versionsverlaufs)
Backups/Mds/

# Supabase-Konfiguration (enthält private E-Mail-Adressen) - siehe config.example.json
Supabase-Sicherung/config.json

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
